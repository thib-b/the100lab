---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GrowthGround from '../components/GrowthGround.astro';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, ''); // '' at root, '/the100lab' on Pages
const description = 'Robocobra Quartet — Hundred Pieces. 100 pieces, coming 2026.';
const ogImage = new URL(base + '/assets/images/og-cover.jpg', Astro.site).href;
// Self-hosted TeX Gyre Heros (a Nimbus Sans / Helvetica-metric design, GUST Font License /
// LPPL 1.3c — web-embeddable). Subset woff2; weight 600 maps to Bold (700). Base-aware string
// because CSS url() can't read the Astro base path. Licence ships in /assets/fonts/.
const fontCss = `@font-face{font-family:"TeX Gyre Heros";font-style:normal;font-weight:400;font-display:swap;src:url("${base}/assets/fonts/TeXGyreHeros-Regular.woff2") format("woff2")}@font-face{font-family:"TeX Gyre Heros";font-style:normal;font-weight:700;font-display:swap;src:url("${base}/assets/fonts/TeXGyreHeros-Bold.woff2") format("woff2")}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={base + '/assets/fonts/TeXGyreHeros-Regular.woff2'} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={base + '/assets/fonts/TeXGyreHeros-Bold.woff2'} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <script is:inline>
      // Pick the plate ground colour before first paint so there is no flash of the
      // default turquoise while GrowthGround's module script (deferred) spins up.
      // GrowthGround.astro reuses window.__groundHex so the canvas tint matches exactly.
      // Palette/inkFor/scrimFor are small self-contained copies of src/data/palette.ts
      // and src/lib/color.ts (kept in sync manually — this must stay inline + tiny).
      (function () {
        var palette = ['#17b6c9', '#f2c80f', '#e8743f', '#2f7fd0', '#9fb833', '#d15a86', '#8163a6', '#bd5230', '#c8347a'];
        function relLum(hex) {
          var h = hex.replace('#', '');
          var c = [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];
          var lin = c.map(function (s) { return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4); });
          return 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2];
        }
        function inkFor(hex) { return relLum(hex) > 0.42 ? '#141414' : '#f4f3ee'; }
        function scrimFor(hex) { return relLum(hex) > 0.5 ? 'rgba(255,255,255,.34)' : 'rgba(0,0,0,.26)'; }
        // Pick once per full page load and reuse across view-transition navigations
        // (this script re-runs on each swap; without this the ground — and the invert-driven
        // logo — would reseed to a new colour on every click).
        var hex = window.__groundHex || palette[Math.floor(Math.random() * palette.length)];
        var ink = inkFor(hex);
        var root = document.documentElement;
        root.style.setProperty('--ground', hex);
        root.style.setProperty('--ink', ink);
        root.style.setProperty('--scrim', scrimFor(hex));
        root.style.setProperty('--logo-invert', ink === '#141414' ? '0' : '1');
        window.__groundHex = hex;
      })();
    </script>
    <title>{title} — Robocobra Quartet</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Hundred Pieces — Robocobra Quartet" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
    <ClientRouter />
  </head>
  <body>
    <GrowthGround />
    <div class="shell">
      <Nav />
      <main><slot /></main>
      <Footer />
    </div>
    <style is:global>
      :root{ --ground:#17b6c9; --ink:#f4f3ee; --scrim:rgba(0,0,0,.26); --logo-invert:0;
        /* Self-hosted TeX Gyre Heros (the web-licensed Nimbus Sans / Helvetica design) is the
           primary face on every device; the rest are metric-compatible fallbacks if it fails to
           load (local Nimbus Sans, Helvetica Neue on Apple, Arial on Windows, Liberation Sans). */
        --sans:"TeX Gyre Heros","Nimbus Sans","Helvetica Neue",Helvetica,Arial,"Liberation Sans",system-ui,sans-serif; }
      *{box-sizing:border-box}
      html,body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.55}
      .shell{max-width:1000px;margin:0 auto;padding:0 clamp(18px,4vw,40px) 72px;position:relative;z-index:1}
      main :is(h1,h2){letter-spacing:-.02em;text-wrap:balance}
      main h1{font-size:clamp(2.2rem,5vw,3.4rem);line-height:1.03;margin:.2em 0 .45em}
      main h2{font-size:clamp(1.35rem,2.4vw,1.85rem)}
      a{color:var(--ink)}
      /* centered content column (like robocobraquartet.com); media fills the column */
      .prose{max-width:900px;margin:0 auto;text-align:center}
      .prose p{max-width:64ch;margin-left:auto;margin-right:auto}
      .prose p:has(img){max-width:none}
      main img{max-width:100%;height:auto;display:block;margin:1.25rem auto;border-radius:8px}
      /* body copy sits on the legibility scrim on the seeded ground */
      .scrim{background:var(--scrim);backdrop-filter:blur(4px);border-radius:14px;padding:1.4rem 1.6rem}
      .embed-responsive{position:relative;width:100%;aspect-ratio:16/9;margin:1rem auto}
      .embed-responsive iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
      /* keep fixed-size embeds (e.g. the 350px Bandcamp player) inside the column, centered */
      .prose iframe{max-width:100%;display:block;margin-left:auto;margin-right:auto}
    </style>
  </body>
</html>
