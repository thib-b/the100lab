---
// The visible title is grown by the GrowthGround canvas (the stamp reveal, upper-centre).
// This splash reuses the same MailingList form as /contact/ (a slim signup posting straight to
// the EmailOctopus endpoint, no third-party JS), kept toward the lower centre so the reveal
// stays clear above it on short screens.
import MailingList from './MailingList.astro';
// import PreSave from './PreSave.astro'; // pre-save/pre-add buttons hidden for now (album out)
---
<section class="splash">
  <h1 class="sr-only">Robocobra Quartet — Hundred Pieces</h1>
  <div class="notify scrim">
    <p class="eyebrow">Hundred Pieces - Out November 13th</p>
    {/* Bandcamp "Haha" taster from Hundred Pieces. */}
    <div class="player">
      <iframe title="Robocobra Quartet — Haha (Bandcamp player)" loading="lazy"
        style="border:0;width:100%;height:42px;"
        src="https://bandcamp.com/EmbeddedPlayer/album=2488495139/size=small/bgcol=ffffff/linkcol=63b2cc/artwork=none/track=1833649138/transparent=true/"
        seamless><a href="https://robocobraquartet.bandcamp.com/album/hundred-pieces">Hundred Pieces by Robocobra Quartet</a></iframe>
    </div>
    {/* Always-visible fallback: privacy browsers (e.g. Firefox/Iceraven ETP) block the Bandcamp
        frame and show a blank box, so this guarantees a working path to the track for everyone. */}
    <p class="player-fallback"><a href="https://robocobraquartet.bandcamp.com/track/haha" target="_blank" rel="noopener">Listen to <em>Haha</em> on Bandcamp ↗</a></p>
    {/* <PreSave /> */}{/* pre-save/pre-add buttons hidden for now (album out) */}
    <MailingList />
  </div>
</section>
<style>
  /* Reserve roughly the space above the centred stamp so the card sits just below the stamp
     and stays fully on-screen; the footer then follows (a short scroll away, which is fine).
     dvh keeps mobile browser chrome from inflating the height. */
  .splash{min-height:calc(100dvh - 200px);display:flex;flex-direction:column;justify-content:flex-end;align-items:center}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .notify{width:100%;max-width:460px;padding:1rem 1.2rem;text-align:center;
    display:flex;flex-direction:column;align-items:center;gap:1rem}
  .eyebrow{margin:0;text-transform:uppercase;letter-spacing:.18em;font-size:.8rem;opacity:.9}
  /* Bandcamp's small player picks a light/dark theme from bgcol's luminance (ffffff = light,
     to match the white email field / cream button); framed with the same 9px rounded corners
     as the pre-save box so it reads as a deliberate "listen" chip. */
  .player{width:100%;max-width:420px;margin:0 auto;border-radius:9px;overflow:hidden;line-height:0}
  .player iframe{display:block}
  /* sits just under the player; small and subtle so it reads as a secondary "listen" link */
  .player-fallback{margin:-.5rem 0 0;font-size:.8rem;opacity:.85}
  .player-fallback a{color:inherit}
</style>
