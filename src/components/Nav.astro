---
import { NAV } from '../data/nav';
---
<nav aria-label="Primary">
  <a class="brand" href="/">Robocobra Quartet</a>
  <ul>
    {NAV.map((n) => (
      <li><a href={n.url} {...(n.external ? { target: '_blank', rel: 'noopener' } : {})}>{n.title}</a></li>
    ))}
  </ul>
</nav>
<style>
  nav{display:flex;gap:1.5rem;align-items:baseline;flex-wrap:wrap;padding:1.2rem 0}
  .brand{font-weight:800;letter-spacing:-.01em;margin-right:auto;text-decoration:none;color:var(--ink)}
  ul{display:flex;gap:1.1rem;list-style:none;margin:0;padding:0;flex-wrap:wrap}
  a{color:var(--ink);text-decoration:none;text-transform:uppercase;letter-spacing:.06em;font-size:.82rem;font-weight:600}
  a:hover,a:focus-visible{text-decoration:underline}
</style>
