---
import { NAV } from '../data/nav';
const base = import.meta.env.BASE_URL.replace(/\/+$/, ''); // '' at root, '/the100lab' on Pages
---
<nav aria-label="Primary">
  <a class="brand" href={base + '/'}><img src={base + '/assets/images/rqlogo.png'} alt="Robocobra Quartet" /></a>
  <ul>
    {NAV.map((n) => (
      <li><a href={n.external ? n.url : base + n.url} {...(n.external ? { target: '_blank', rel: 'noopener' } : {})}>{n.title}</a></li>
    ))}
  </ul>
</nav>
<style>
  nav{display:flex;align-items:center;gap:1.25rem;padding:1.1rem 0;flex-wrap:wrap}
  .brand{margin-right:auto;display:inline-flex;text-decoration:none}
  .brand img{height:40px;width:auto;display:block;filter:invert(var(--logo-invert,0))}
  ul{display:flex;gap:1.1rem;list-style:none;margin:0;padding:0;flex-wrap:wrap}
  ul a{color:var(--ink);text-decoration:none;text-transform:uppercase;letter-spacing:.06em;font-size:.82rem;font-weight:600}
  ul a:hover,ul a:focus-visible{text-decoration:underline}
  @media (max-width:640px){
    nav{justify-content:center;text-align:center}
    .brand{margin-right:0;flex:0 0 100%;justify-content:center}
    ul{justify-content:center;width:100%;gap:.9rem 1rem}
  }
</style>
