---
// EmailOctopus signup via the vendor's own embed script. We deliberately use the embed (rather
// than a rolled-our-own POST) because EmailOctopus's reCAPTCHA — the fix for bot signups — is only
// validated server-side against the hosted form, so it can't ride on a custom POST. The embed
// injects inline DOM (not an iframe), so we hide its "Powered by EmailOctopus" badge and restyle the
// injected form to match the site (see the is:global block). reCAPTCHA is enabled in the EmailOctopus
// dashboard, not here.
const FORM_ID = '4baae2fc-ad1b-11f1-9b68-07886df76fee';
const EMBED_SRC = `https://eocampaign1.com/form/${FORM_ID}.js`;

interface Props {
  heading?: string;
  button?: string;
}
const { heading, button = 'Notify me' } = Astro.props;
---
<div class="ml">
  {heading && <h3 class="ml-heading">{heading}</h3>}
  {/* The embed injects its form inside this mount. Our own heading above stands in for EO's. */}
  <div class="ml-eo" data-eo-src={EMBED_SRC} data-eo-form={FORM_ID} data-eo-btn={button}></div>
</div>

<style>
  /* Our own wrapper + heading (scoped). Same sizing as before so the field stays the same width
     everywhere: slim in the 460px splash card, capped rather than stretching the wide /contact/ column. */
  .ml{width:100%;max-width:420px;margin-inline:auto}
  .ml-heading{margin:0 0 .7rem;font-size:1.05rem}
</style>

<style is:global>
  /* Override EmailOctopus's injected form to match the site. Selectors match the embed's real decoded
     markup: form.emailoctopus-form > .main-form > [eo-form-fields-container] > .emailoctopus-form-row
     > input#field_0.form-control, then <input type="submit" class="btn w-100 btn-primary"> inside
     .main-form; success/error are <p class="emailoctopus-(success|error)-message"> siblings ABOVE the
     form; the badge is .mastfoot. There is no EO heading or <label> to hide. Must be global +
     !important: the DOM is injected at runtime (Astro scoped styles never reach it) and EmailOctopus
     ships its own stylesheet (and beats the wrapper's inline styles, which are not !important). */
  .ml-eo,
  .ml-eo *{box-sizing:border-box}
  /* strip EO's card chrome so it sits flush like the old form */
  .ml-eo .inline-container,
  .ml-eo .form-container,
  .ml-eo .emailoctopus-form-wrapper,
  .ml-eo .emailoctopus-form,
  .ml-eo .main-form{margin:0!important;padding:0!important;max-width:none!important;
    width:100%!important;background:none!important;border:0!important;box-shadow:none!important}
  /* hide the "Powered by EmailOctopus" badge */
  .ml-eo .mastfoot{display:none!important}
  /* one nowrap row: flex on .main-form (holds the field + submit), with display:contents dissolving
     EO's nested field wrappers so the email input and submit input become direct flex siblings */
  .ml-eo .main-form{display:flex!important;gap:.5rem!important;flex-wrap:nowrap!important;
    justify-content:center;align-items:stretch}
  /* the email <input> ignores the inherited 1.55 line-height for its box height while the submit
     honours it, so let both stretch to the same row height (text stays vertically centred) */
  .ml-eo [eo-form-fields-container],
  .ml-eo .emailoctopus-form-row{display:contents!important}
  /* keep the honeypot row out of the flow */
  .ml-eo .emailoctopus-form-row-hp{position:absolute!important;left:-5000px!important;width:1px!important;
    height:1px!important;overflow:hidden!important}
  /* email input: matches the old .ml-email exactly. height:auto removes EO's pinned .form-control
     height so align-items:stretch can size it to the submit's height. */
  .ml-eo input[type="email"],
  .ml-eo .form-control{flex:1 1 0!important;min-width:0!important;width:auto!important;height:auto!important;
    padding:.62rem .85rem!important;border-radius:9px!important;border:1px solid rgba(0,0,0,.18)!important;
    background:rgba(255,255,255,.94)!important;color:#141414!important;font:inherit!important;margin:0!important}
  /* submit: matches the old .ml-submit exactly (ink fill, ground text); overrides EO's w-100 + mb-2 */
  .ml-eo input[type="submit"],
  .ml-eo .btn-primary{flex:0 0 auto!important;white-space:nowrap!important;width:auto!important;
    padding:.62rem 1.15rem!important;border-radius:9px!important;border:1px solid var(--ink)!important;
    background:var(--ink)!important;color:var(--ground)!important;cursor:pointer;font:inherit!important;
    font-weight:600!important;transition:opacity .15s;margin:0!important}
  .ml-eo input[type="submit"]:hover,
  .ml-eo .btn-primary:hover{opacity:.85}
  .ml-eo input[type="submit"]:disabled,
  .ml-eo .btn-primary:disabled{opacity:.55;cursor:default}
  /* success / error line (empty until submit); only take vertical space once populated */
  .ml-eo .emailoctopus-success-message,
  .ml-eo .emailoctopus-error-message{margin:0!important;font-size:.92rem;color:inherit!important}
  .ml-eo .emailoctopus-success-message:not(:empty),
  .ml-eo .emailoctopus-error-message:not(:empty){margin:0 0 .7rem!important}
</style>

<script is:inline>
  // Inject the EmailOctopus embed into each .ml-eo mount. Runs on astro:page-load so it fires on the
  // first load AND every ClientRouter (view-transition) navigation — the form lives on the splash and
  // on /contact/, and soft navigations swap in fresh .ml-eo nodes that need the embed re-injected.
  (function () {
    function mount(el) {
      if (el.dataset.mounted) return;            // per-node guard: never double-inject one mount
      el.dataset.mounted = '1';
      // Once the embed's DOM appears, force the button label to our text. EO renders the submit as an
      // <input type="submit"> (labelled via value), so set .value; fall back to textContent if it's a
      // <button>. This keeps the label matching the site regardless of the EO dashboard setting.
      var obs = new MutationObserver(function () {
        var btn = el.querySelector('input[type="submit"], button[type="submit"]');
        if (!btn) return;                         // the submit is the last thing we wait for
        if (el.dataset.eoBtn) {
          if (btn.tagName === 'INPUT') btn.value = el.dataset.eoBtn;
          else btn.textContent = el.dataset.eoBtn;
        }
        obs.disconnect();
      });
      obs.observe(el, { childList: true, subtree: true });
      var s = document.createElement('script');
      s.async = true;
      s.src = el.dataset.eoSrc;
      s.setAttribute('data-form', el.dataset.eoForm);
      el.appendChild(s);                          // embed uses currentScript, so form lands in .ml-eo
    }
    function mountAll() { document.querySelectorAll('.ml-eo').forEach(mount); }
    if (!window.__mlEOBound) {                     // bind the listener once, even if this script re-runs
      window.__mlEOBound = true;
      document.addEventListener('astro:page-load', mountAll);
    }
    mountAll();                                     // handle the case where page-load already fired
  })();
</script>
