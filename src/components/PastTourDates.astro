---
import { pastTourDates } from '../data/pastTourDates';

// Group the (already newest-first) list into contiguous year buckets, deriving
// the year from the DD/MM/YY date's last two digits (all entries are 20YY).
type Group = { year: string; rows: typeof pastTourDates };
const groups: Group[] = [];
for (const row of pastTourDates) {
  const yy = row.date.slice(6, 8);
  const year = `20${yy}`;
  const last = groups[groups.length - 1];
  if (last && last.year === year) {
    last.rows.push(row);
  } else {
    groups.push({ year, rows: [row] });
  }
}
---
<section class="past-tour-dates">
  <h2>Past Tour Dates</h2>
  {groups.map((group) => (
    <div class="year-group">
      <h3 class="year">{group.year}</h3>
      <ul class="rows">
        {group.rows.map((row) => (
          <li class="row">
            <span class="date">{row.date}</span>
            <span class="location">{row.location}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
<style>
  .past-tour-dates { margin-top: 2.5rem; text-align: center; }
  .past-tour-dates h2 { margin-bottom: 1.5rem; }
  .year-group { margin: 0 auto 1.75rem; max-width: 640px; }
  .year {
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: .6;
    margin: 0 0 .5rem;
    padding-bottom: .35rem;
    border-bottom: 1px solid var(--scrim);
  }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: .3rem 0;
    border-bottom: 1px solid var(--scrim);
    text-align: left;
  }
  .row:last-child { border-bottom: none; }
  .date {
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
    font-size: .85rem;
    opacity: .75;
    color: var(--ink);
  }
  .location {
    flex: 1 1 auto;
    text-align: right;
    font-size: .9rem;
    color: var(--ink);
  }
  @media (max-width: 480px) {
    .row { flex-direction: column; gap: .1rem; }
    .location { text-align: left; }
  }
</style>
