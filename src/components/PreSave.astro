<style>
  .presave{display:flex;flex-direction:column;align-items:center;gap:.55rem;
    width:100%;max-width:420px;margin:0 auto;padding:.8rem 1rem;box-sizing:border-box;
    border:1px solid var(--ink);border-radius:11px;text-decoration:none;color:var(--ink);
    background:transparent;transition:background .15s,color .15s}
  .presave:hover,.presave:focus-visible{background:var(--ink);color:var(--ground)}
  .presave-cta{font-weight:600;text-transform:uppercase;letter-spacing:.12em;font-size:.82rem}
  .presave-logos{display:flex;gap:.95rem;align-items:center}
  /* fill is an inherited SVG property, so the single-path marks pick up currentColor here */
  .presave-logos svg{width:22px;height:22px;display:block;fill:currentColor}
</style>
